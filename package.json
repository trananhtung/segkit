{
  "name": "@billdaddy/segkit",
  "version": "0.1.0",
  "description": "Zero-dependency segment tree and Fenwick tree (BIT) for range queries and prefix sums — TypeScript-first npm equivalent of Python sortedcontainers range structures and Java segment trees.",
  "keywords": [
    "segment-tree",
    "fenwick-tree",
    "binary-indexed-tree",
    "bit",
    "range-query",
    "prefix-sum",
    "data-structure",
    "typescript",
    "algorithm"
  ],
  "homepage": "https://github.com/trananhtung/segkit#readme",
  "bugs": {
    "url": "https://github.com/trananhtung/segkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trananhtung/segkit.git"
  },
  "license": "MIT",
  "author": "trananhtung",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  }
}
